---
import type { Product } from "../../data/products";

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<article class="shop-card reveal">
  <div class="product-image-area">
    <img
      class="product-photo"
      src={product.image}
      alt={product.alt}
      loading="lazy"
      data-product-image={product.id}
    />
    <div class="phone-art" aria-hidden="true">
      <div class={`phone-screen ${product.screen}`}></div>
    </div>
  </div>
  <div class="product-content">
    <p class="product-badge">{product.badge}</p>
    <h3>{product.name}</h3>
    <p class="muted-text product-description">{product.description}</p>
    <p class="product-price">{product.price}</p>
    <label class="photo-picker">
      Change photo
      <input
        class="visually-hidden"
        type="file"
        accept="image/*"
        data-image-input={product.id}
      />
    </label>
    <p class="image-status" aria-live="polite" data-image-status></p>
    <a class="shop-button inquire-button" href="#contact">Inquire now</a>
  </div>
</article>

<style>
  .shop-card {
    min-width: 0;
    overflow: hidden;
    color: var(--palette-text);
    background: var(--palette-surface);
    border: 1px solid var(--palette-border);
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .shop-card:hover {
    transform: translateY(-4px);
    border-color: #ff6a0080;
  }

  .product-image-area {
    position: relative;
    min-height: 205px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--palette-surface);
  }

  .product-image-area > .phone-art {
    transform: scale(0.88);
  }

  .product-content {
    padding: 16px;
  }

  .product-badge {
    margin: 0 0 6px;
    color: var(--palette-accent);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h3 {
    margin: 0;
    font-size: 18px;
    font-weight: 800;
  }

  .product-description {
    min-height: 54px;
    margin: 9px 0;
    font-size: 12px;
    line-height: 1.55;
  }

  .product-price {
    margin: 0 0 12px;
    font-size: 20px;
    font-weight: 900;
  }

  .photo-picker {
    min-height: 34px;
    padding: 8px 10px;
    display: inline-flex;
    align-items: center;
    color: var(--palette-accent);
    border: 1px solid #ff6a0080;
    cursor: pointer;
    font-size: 11px;
    font-weight: 700;
  }

  .photo-picker:hover {
    background: #ff6a0018;
  }

  .photo-picker:focus-within {
    outline: 2px solid var(--palette-accent);
    outline-offset: 3px;
  }

  .image-status {
    min-height: 14px;
    margin: 5px 0 8px;
    color: var(--palette-muted);
    font-size: 10px;
    line-height: 1.4;
  }

  .inquire-button {
    width: 100%;
  }

  @media (max-width: 680px) {
    .product-image-area {
      min-height: 230px;
    }
  }
</style>
